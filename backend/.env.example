APP_ENV=development
MESSAGE_NOTIFICATION_RELAY_WAKE_ENABLED=false
# Optional approved canary only: JSON array of at most two recipientUserId/deviceSessionId UUID pairs.
# Both the enabled flag and an exact pair are required; no wildcard or global fallback.
MESSAGE_NOTIFICATION_RELAY_WAKE_TARGETS=[]
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kryno
JWT_ISSUER=kryno-auth
JWT_AUDIENCE=kryno-mobile
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_OTP_TTL_MINUTES=10
APP_BASE_URL=https://your-live-kryno-url.example
EMAIL_FROM=hello@yourdomain.com
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
REDIS_URL=rediss://default:password@your-redis-host:6379
REDIS_TLS=true
WAF_PROVIDER=cloudflare
SECURITY_ALERT_EMAIL=security@yourdomain.com
BACKUP_POLICY_URL=https://docs.yourdomain.com/kryno/backup-recovery
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
MEDIA_STORAGE_DRIVER=s3
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET=kryno-media
R2_PUBLIC_BASE_URL=https://media.yourdomain.com
KRYNO_TURN_URLS=turns:turn.yourdomain.com:5349
KRYNO_TURN_USERNAME=your-turn-username
KRYNO_TURN_CREDENTIAL=your-turn-password
LIVEKIT_URL=https://your-livekit-host
LIVEKIT_API_KEY=your-livekit-key
LIVEKIT_API_SECRET=your-livekit-secret
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret
